<Window x:Class="AntigravityAutomation.ClaudeSchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AntigravityAutomation.ViewModels"
        mc:Ignorable="d"
        Title="Claude 终端定时指令调度器"
        Height="620" Width="560"
        MinHeight="520" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="#181825"
        Foreground="#F0F0F0"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- ════════════════════════ 基础色彩体系 ════════════════════════ -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#181825" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#222233" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#38384E" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#13131E" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3A3A52" />
        <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="#5CBF60" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#2196F3" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="LightTextBrush" Color="#F3F4F6" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ════════════════════════ 现代极简深色细滚动条 ════════════════════════ -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                Background="#3E3E58"
                                CornerRadius="3"
                                Margin="1,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#5E5E7E" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#4CAF50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════ 卡片容器样式 ════════════════════════ -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="8" ShadowDepth="2" Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════ 现代深色输入框 ════════════════════════ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#4CAF50" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#545472" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InputFocusBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数字微调输入框 -->
        <Style x:Key="NumberTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="30" />
        </Style>

        <!-- ════════════════════════ 现代深色单选按钮 RadioButton ════════════════════════ -->
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{StaticResource LightTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="OuterCircle"
                                         Stroke="{StaticResource InputBorderBrush}"
                                         StrokeThickness="1.5"
                                         Fill="{StaticResource InputBackgroundBrush}" />
                                <Ellipse x:Name="InnerDot"
                                         Width="8" Height="8"
                                         Fill="{StaticResource AccentGreenBrush}"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="{StaticResource AccentGreenBrush}" />
                                <Setter TargetName="InnerDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#626284" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════ 现代深色复选框 CheckBox ════════════════════════ -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource LightTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="17" Height="17"
                                    CornerRadius="4"
                                    BorderBrush="{StaticResource InputBorderBrush}"
                                    BorderThickness="1.5"
                                    Background="{StaticResource InputBackgroundBrush}"
                                    Margin="0,0,9,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 3.5 8 L 6.5 11 L 13 4"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.8"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGreenBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#626284" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════ 现代深色下拉菜单 ComboBox ════════════════════════ -->
        <!-- 下拉菜单项样式 -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="5"
                                Margin="2,1"
                                Padding="10,7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D44" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#353550" />
                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框触发按钮模板 -->
        <ControlTemplate x:Key="ModernComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="6"
                        Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" />
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4.5 4.5 L 9 0"
                      Stroke="{StaticResource MutedTextBrush}"
                      StrokeThickness="1.6"
                      StrokeEndLineCap="Round"
                      StrokeStartLineCap="Round" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#545472" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentGreenBrush}" />
                    <Setter TargetName="Arrow" Property="Data" Value="M 0 4.5 L 4.5 0 L 9 4.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 现代深色 ComboBox 控件样式 -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ModernComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#252538"
                                            BorderThickness="1"
                                            BorderBrush="#3D3D58"
                                            CornerRadius="6"
                                            Margin="0,3,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.4" Direction="270" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════ 现代深色日期选择器 DatePicker ════════════════════════ -->
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Foreground="#FFFFFF"
                                      Focusable="False"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="IsTodayHighlighted" Value="True" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Border x:Name="Border"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Height="30"
                                Padding="2,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Foreground="#FFFFFF"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   VerticalContentAlignment="Center"
                                                   Padding="6,0,0,0"
                                                   Focusable="{TemplateBinding Focusable}" />
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="26" Height="26"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="4">
                                                <!-- 现代日历矢量小图标 -->
                                                <Path HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 2 4 L 13 4 L 13 13 L 2 13 Z M 2 7 L 13 7 M 4.5 2 L 4.5 4 M 10.5 2 L 10.5 4"
                                                      Stroke="{StaticResource MutedTextBrush}"
                                                      StrokeThickness="1.3"
                                                      Fill="Transparent" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}"
                                       StaysOpen="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#545472" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════ 按钮样式库 ════════════════════════ -->
        <!-- 次级功能小按钮 (刷新、定位等) -->
        <Style x:Key="SmallBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D40" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3B3B52" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4F4F6D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#252535" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 常用预设胶囊按钮 (Pill Button) -->
        <Style x:Key="PresetChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A3D" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#38384E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#383852" />
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#222232" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ════════════════════════ 主界面布局 ════════════════════════ -->
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <!-- 0: 顶部标题栏卡片 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 主配置面板 (自适应滚动) -->
            <RowDefinition Height="*" />
            <!-- 2: 底部操作栏卡片 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ════════════════ 顶部标题栏 ════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="⏱️ AI 终端定时指令调度器 (Claude / Kimi Code)"
                               FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="精准绑定 Claude 或 Kimi Code 终端，在套餐额度重置时自动唤醒并注入指令"
                               FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#161622" BorderBrush="#35354D" BorderThickness="1"
                        CornerRadius="5" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RemainingTimeString}"
                               Foreground="{StaticResource AccentGreenBrush}"
                               FontWeight="Bold" FontSize="14" FontFamily="Consolas, Cascadia Code, Courier New" />
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════ 主配置滚动面板 ════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Orientation="Vertical">

                <!-- 1. 目标终端选择 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <!-- 目标 CLI 工具类型切换行 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1. 监控目标 CLI 工具："
                                       FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <RadioButton Content="Claude (Claude Code)"
                                             IsChecked="{Binding IsClaudeTarget, Mode=TwoWay}"
                                             GroupName="TargetCliToolGroup"
                                             Margin="0,0,16,0" />
                                <RadioButton Content="Kimi Code (Kimi CLI)"
                                             IsChecked="{Binding IsKimiTarget, Mode=TwoWay}"
                                             GroupName="TargetCliToolGroup" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding TerminalProcesses}"
                                      SelectedItem="{Binding SelectedTerminal}"
                                      DisplayMemberPath="DisplayText"
                                      ToolTip="请选择要注入指令的 PowerShell 或终端窗口" />
                            <Button Grid.Column="1"
                                    Content="🔄 刷新"
                                    Style="{StaticResource SmallBtnStyle}"
                                    Margin="8,0,0,0"
                                    Command="{Binding RefreshTerminalsCommand}"
                                    ToolTip="重新枚举系统中的所有终端窗口" />
                            <Button Grid.Column="2"
                                    Content="👁️ 闪烁定位"
                                    Style="{StaticResource SmallBtnStyle}"
                                    Margin="6,0,0,0"
                                    Command="{Binding FlashTargetCommand}"
                                    ToolTip="短暂置顶并闪烁所选终端窗口，以供肉眼确认" />
                        </Grid>
                        <TextBlock Text="★ 带有绿色标记者为检测到对应 CLI 工具的终端；切换上方工具会自动重新置顶推荐。"
                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="2,7,0,0" />
                    </StackPanel>
                </Border>

                <!-- 2. 定时方式配置 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="2. 定时触发方式"
                                   FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,10" />

                        <!-- 方式一：倒计时模式 -->
                        <RadioButton IsChecked="{Binding IsCountdownMode}"
                                     GroupName="TimingModeGroup"
                                     Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="倒计时模式：" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Style="{StaticResource NumberTextBoxStyle}"
                                         Text="{Binding CountdownHours, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text=" 时 " VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox Style="{StaticResource NumberTextBoxStyle}"
                                         Text="{Binding CountdownMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text=" 分 " VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox Style="{StaticResource NumberTextBoxStyle}"
                                         Text="{Binding CountdownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text=" 秒 后触发" VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 常用预设胶囊按钮行 -->
                        <StackPanel Orientation="Horizontal" Margin="26,4,0,10">
                            <TextBlock Text="快速预设：" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <Button Content="5小时 (推荐)" Style="{StaticResource PresetChipStyle}" Click="Preset5Hours_Click" />
                            <Button Content="1小时" Style="{StaticResource PresetChipStyle}" Click="Preset1Hour_Click" />
                            <Button Content="30分钟" Style="{StaticResource PresetChipStyle}" Click="Preset30Mins_Click" />
                            <Button Content="10秒 (快速测试)" Style="{StaticResource PresetChipStyle}" Click="Preset10Secs_Click" />
                        </StackPanel>

                        <Separator Background="{StaticResource CardBorderBrush}" Margin="0,4,0,10" />

                        <!-- 方式二：定点时刻模式 -->
                        <RadioButton IsChecked="{Binding IsSpecificTimeMode}"
                                     GroupName="TimingModeGroup"
                                     Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="定点时刻模式：" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding SpecificDate}"
                                            Height="30" Width="125"
                                            VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Style="{StaticResource NumberTextBoxStyle}"
                                         Text="{Binding SpecificHour, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text=" 时 " VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox Style="{StaticResource NumberTextBoxStyle}"
                                         Text="{Binding SpecificMinute, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text=" 分 准时执行" VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- 3. 发送指令与执行选项 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="3. 注入指令内容"
                                   FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,8" />
                        <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 ToolTip="到达定时时间后将自动输入到 Claude 终端中的指令内容" />

                        <CheckBox IsChecked="{Binding AutoPressEnter}"
                                  Content="发送完成后自动按回车键 (Enter) 提交"
                                  Margin="0,0,0,8" />

                        <CheckBox IsChecked="{Binding MinimizeToTray}"
                                  Content="启动定时后自动将主工具隐藏至右下角系统托盘 (纯后台运行)"
                                  Margin="0,0,0,2" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════ 底部操作栏 ════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Margin="0,8,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 状态提示 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 中止按钮（运行中可见） -->
                <Button Grid.Column="1"
                        Content="⏹️ 中止定时"
                        Command="{Binding CancelScheduleCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                        Height="36" Padding="14,4" Margin="6,0"
                        Background="#B91C1C" Foreground="#FFFFFF"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#DC2626" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 启动按钮 -->
                <Button Grid.Column="2"
                        Content="🚀 启动定时并转入后台"
                        Command="{Binding StartScheduleCommand}"
                        Height="36" Padding="16,4"
                        Background="{StaticResource AccentGreenBrush}"
                        Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource AccentGreenHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 关闭窗口按钮 -->
                <Button Grid.Column="3"
                        Content="关闭"
                        Click="CloseButton_Click"
                        Style="{StaticResource SmallBtnStyle}"
                        Height="36" Padding="14,4" Margin="8,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
