<!--文件用途：应用程序主窗口 XAML 定义（现代深色主题三区布局）。
    设计风格：VS Code / 终端风格深色主题，主背景 #1E1E2E，卡片背景 #2D2D3F，
    强调色绿色 #4CAF50（开始/成功）、红色 #E53935（停止/错误）、蓝色 #2196F3（信息）。
    布局精简为三区：
      第 0 行：顶部状态栏（状态指示灯呼吸动画 + 标题 + 状态文字）。
      第 1 行：控制面板（主操作按钮 + 统计信息 + 高级设置可折叠）。
      第 2 行：日志面板（终端风格等宽字体 + 级别着色 + 自动滚动 + 清空按钮）。
    所有交互控件通过 DataContext 绑定到 MainViewModel 的响应式属性与 ReactiveCommand。
    状态指示灯呼吸动画通过 Storyboard 控制 Ellipse 的 Opacity 循环，由 IsRunning 触发。
    按钮悬停效果通过 Style Trigger 改变 Background 实现，不依赖第三方动画库。-->
<Window x:Class="AntigravityAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AntigravityAutomation.ViewModels"
        xmlns:models="clr-namespace:AntigravityAutomation.Models"
        Title="Antigravity 自动确认工具"
        Height="480" Width="660"
        MinHeight="360" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E2E"
        FontFamily="Segoe UI"
        Foreground="#E0E0E0">
    <Window.Resources>
        <!-- ════════════════════════ 颜色资源 ════════════════════════ -->
        <Color x:Key="MainBgColor">#1E1E2E</Color>
        <Color x:Key="CardBgColor">#2D2D3F</Color>
        <Color x:Key="LogBgColor">#1A1A2E</Color>
        <Color x:Key="AccentGreenColor">#4CAF50</Color>
        <Color x:Key="AccentRedColor">#E53935</Color>
        <Color x:Key="AccentBlueColor">#2196F3</Color>
        <Color x:Key="AccentOrangeColor">#FF9800</Color>
        <Color x:Key="MutedTextColor">#9E9E9E</Color>

        <SolidColorBrush x:Key="MainBgBrush" Color="{StaticResource MainBgColor}" />
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
        <SolidColorBrush x:Key="LogBgBrush" Color="{StaticResource LogBgColor}" />
        <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
        <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
        <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrangeColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3F3F55" />

        <!-- ════════════════════════ 卡片样式（圆角 + 轻阴影） ════════════════════════ -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3F3F55" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black"
                                      Opacity="0.25"
                                      BlurRadius="8"
                                      ShadowDepth="2"
                                      Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════ 主操作按钮样式（绿色，大尺寸） ════════════════════════ -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#5CBF60" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#3A3A4A" />
                                <Setter Property="Foreground" Value="#777" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════ 停止按钮样式（红色） ════════════════════════ -->
        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRedBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#EF5350" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#3A3A4A" />
                                <Setter Property="Foreground" Value="#777" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════ 次级按钮样式（蓝色/灰色描边） ════════════════════════ -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3D3D52" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#4D4D63" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#2A2A38" />
                                <Setter Property="Foreground" Value="#666" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════ 输入框样式 ════════════════════════ -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A2E" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="CaretBrush" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- ════════════════════════ 状态指示灯呼吸动画 ════════════════════════ -->
        <Storyboard x:Key="StatusBreathingStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3"
                             Duration="0:0:1"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 第 0 行：顶部状态栏 -->
            <RowDefinition Height="Auto" />
            <!-- 第 1 行：控制面板 -->
            <RowDefinition Height="Auto" />
            <!-- 第 2 行：日志面板（占用剩余空间） -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ════════════════════════ 第 0 行：顶部状态栏 ════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 状态指示灯 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 标题 -->
                    <ColumnDefinition Width="*" />
                    <!-- 状态文字 -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 状态指示灯：监控中绿色呼吸 / 已停止灰色 / 错误红色 -->
                <Ellipse Grid.Column="0" x:Name="StatusIndicator"
                         Width="14" Height="14" Margin="0,0,12,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource MutedTextBrush}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <!-- 运行中：绿色 + 启动呼吸动画 -->
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}" />
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                                <!-- 已连接但未运行（如刚停止但连接还在）：蓝色 -->
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- 标题文字 -->
                <TextBlock Grid.Column="1"
                           Text="Antigravity 自动确认工具"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#F0F0F0"
                           VerticalAlignment="Center" />

                <!-- 状态文字 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="状态：" Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="{Binding CurrentStatus}"
                               FontWeight="SemiBold"
                               Foreground="#F0F0F0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════ 第 1 行：控制面板 ════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">

                <!-- 主操作按钮行 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="RunAutomationButton"
                            Content="● 开始监控"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="160"
                            Margin="0,0,10,0"
                            Command="{Binding RunAutomationCommand}"
                            ToolTip="持续监控匹配的交互项并自动按 Enter 确认" />
                    <Button x:Name="StopButton"
                            Content="■ 停止"
                            Style="{StaticResource StopButtonStyle}"
                            MinWidth="100"
                            Command="{Binding StopCommand}"
                            ToolTip="停止当前正在执行的监控" />
                </StackPanel>

                <!-- 统计信息行 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 确认次数 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="确认次数: " Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConfirmationCount}"
                                   FontWeight="Bold" FontSize="15"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- CDP 端口 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="CDP 端口: " Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CdpPort}"
                                   FontWeight="Bold" FontSize="15"
                                   Foreground="{StaticResource AccentBlueBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 连接状态 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="连接: " Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <Ellipse Width="10" Height="10" Margin="4,0,4,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="未连接" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="已连接" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- 运行状态 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Text="运行: " Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="空闲" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="监控中" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 高级设置（可折叠） -->
                <Expander Header="▸ 高级设置"
                          Foreground="{StaticResource MutedTextBrush}"
                          BorderThickness="0"
                          Margin="0,4,0,0"
                          Padding="0">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 第 0 行：目标交互行文字（不区分大小写） -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="交互文字："
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                 x:Name="InteractiveTextTextBox"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Text="{Binding YesAllowButtonText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,6"
                                 ToolTip="匹配的交互行文本（不区分大小写，默认：Yes, allow this time）" />
                        <Button Grid.Row="0" Grid.Column="3"
                                Content="保存配置"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,0,6"
                                Command="{Binding SaveConfigCommand}"
                                ToolTip="将当前配置保存到 appsettings.json" />

                        <!-- 第 1 行：应用路径 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="应用路径："
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 x:Name="AppPathTextBox"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Text="{Binding AppExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"
                                 ToolTip="Antigravity IDE 可执行文件绝对路径" />
                        <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                x:Name="BrowseButton"
                                Content="浏览..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,0,0"
                                Click="BrowseButton_Click"
                                ToolTip="选择 Antigravity 可执行文件" />
                    </Grid>
                </Expander>
            </StackPanel>
        </Border>

        <!-- ════════════════════════ 第 2 行：日志面板 ════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 日志标题栏 -->
                    <RowDefinition Height="Auto" />
                    <!-- 日志列表 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 日志标题栏：左侧标题 + 右侧清空按钮 -->
                <Grid Grid.Row="0" Margin="14,10,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="实时日志"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#F0F0F0"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            x:Name="ClearLogButton"
                            Content="清空日志"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="26"
                            Click="ClearLogButton_Click"
                            ToolTip="清空当前显示的所有日志条目" />
                </Grid>

                <!-- 日志列表：终端风格等宽字体 + 级别着色 -->
                <ListBox Grid.Row="1"
                         x:Name="LogListBox"
                         ItemsSource="{Binding LogEntries}"
                         Background="{StaticResource LogBgBrush}"
                         Foreground="#E0E0E0"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Margin="0,0,0,0"
                         Padding="6,0,6,4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,1" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LogEntry}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <!-- 时间戳 HH:mm:ss -->
                                    <ColumnDefinition Width="78" />
                                    <!-- 级别 -->
                                    <ColumnDefinition Width="56" />
                                    <!-- 步骤 -->
                                    <ColumnDefinition Width="110" />
                                    <!-- 消息 -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 时间戳 -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                           Foreground="#7A7A8A"
                                           FontFamily="Cascadia Code, Consolas, monospace"
                                           FontSize="12" />
                                <!-- 级别（按级别着色） -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Level}"
                                           FontWeight="Bold"
                                           FontFamily="Cascadia Code, Consolas, monospace"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#9E9E9E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="INFO">
                                                    <Setter Property="Foreground" Value="#4CAF50" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                    <Setter Property="Foreground" Value="#FF9800" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                    <Setter Property="Foreground" Value="#E53935" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 步骤 -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Step, TargetNullValue=''}"
                                           Foreground="#7A7A8A"
                                           FontFamily="Cascadia Code, Consolas, monospace"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- 消息 -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Message}"
                                           Foreground="#D0D0D0"
                                           FontFamily="Cascadia Code, Consolas, monospace"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>

    <!-- ════════════════════════ 状态指示灯呼吸动画触发 ════════════════════════
         通过 IsRunning 数据触发：true 时启动呼吸 Storyboard，false 时停止。
         Storyboard 控制 StatusIndicator 的 Opacity 在 1.0→0.3→1.0 循环，周期 2 秒。 -->
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BreathingStoryboard" Storyboard="{StaticResource StatusBreathingStoryboard}" />
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BreathingStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
</Window>
